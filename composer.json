{
    "name": "libriciel/twig-switch",
    "license": "Apache-2.0",
    "description": "Provides a {% switch %} tag for Twig switch case statements",
    "authors": [
        {
            "name": "TJ Draper",
            "email": "tj@buzzingpixel.com",
            "homepage": "https://buzzingpixel.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "twig/twig": "^2.7|^3.0"
    },
    "require-dev": {
        "roave/security-advisories": "dev-master",
        "squizlabs/php_codesniffer": "^3.4",
        "phpmd/phpmd": "^2.6",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "buzzingpixel\\twigswitch\\": "src"
        }
    },
    "extra": {
        "twigExtensions": [
            "buzzingpixel\\twigswitch\\SwitchTwigExtension"
        ]
    }
}
